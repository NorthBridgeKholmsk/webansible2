<div class="d-flex align-items-center justify-content-between mb-4">
  <h1 class="h4 mb-0">Настройки</h1>
</div>

<%= form_with url: settings_path, method: :patch, class: "g-3" do |f| %>
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white">Общие</div>
    <div class="card-body">
      <div class="mb-3">
        <%= label_tag "settings[theme]", "Тема", class: "form-label" %>
        <%= select_tag "settings[theme]", options_for_select([["Светлая", "light"], ["Тёмная", "dark"]], @settings["theme"]), class: "form-select", style: "max-width: 400px" %>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white">Zabbix</div>
    <div class="card-body">
      <div class="mb-3">
        <%= label_tag "settings[zabbix_url]", "Адрес Zabbix", class: "form-label" %>
        <%= text_field_tag "settings[zabbix_url]", @settings["zabbix_url"], class: "form-control", style: "max-width: 500px" %>
      </div>
      <div class="mb-3">
        <%= label_tag "settings[zabbix_api_key]", "API-ключ Zabbix", class: "form-label" %>
        <%= password_field_tag "settings[zabbix_api_key]", nil, class: "form-control", style: "max-width: 500px", placeholder: @zabbix_masked.presence || "не задан" %>
        <div class="form-text">Хранится в базе зашифрованным. Оставьте поле пустым, чтобы не менять текущий ключ.</div>
      </div>
      <div class="mb-3">
        <%= check_box_tag "settings[zabbix_insecure_ssl]", "1", @zabbix_insecure, id: "settings_zabbix_insecure_ssl" %>
        <%= label_tag "settings_zabbix_insecure_ssl", "Не проверять TLS-сертификат (self-signed)", class: "form-check-label" %>
        <div class="form-text">Отключает проверку сертификата — только для внутренних Zabbix с самоподписанным сертификатом.</div>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= submit_tag "Сохранить", class: "btn btn-primary" %>
    <%= link_to "Отмена", settings_path, class: "btn btn-secondary" %>
  </div>
<% end %>
