<%= form_with model: @organization, url: (@organization.persisted? ? organization_path(@organization) : organizations_path), method: (@organization.persisted? ? :patch : :post), class: "row g-3" do |f| %>
  <div class="col-md-6">
    <%= f.label :name, "Название", class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>
  <div class="col-md-6">
    <%= f.label :source, "Источник", class: "form-label" %>
    <%# Нередактируемое поле: фиксируется при создании (UI — «Вручную», синк Zabbix — «Zabbix»). %>
    <input type="text" class="form-control" value="<%= @organization.persisted? ? @organization.source_label : "Вручную" %>" disabled>
  </div>
  <div class="col-12">
    <label class="form-label">Переменные организации</label>
    <div id="variables-container" data-variable-prefix="organization">
      <% @organization.variables.each_with_index do |v, i| %>
        <%= render "variables/form_field", f: f, variable: v, index: i, prefix: "organization" %>
      <% end %>
    </div>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="add-variable">Добавить переменную</button>
  </div>
  <div class="col-12">
    <div class="d-flex gap-2">
      <%= f.submit "Сохранить", class: "btn btn-primary" %>
      <%= link_to "Отмена", organizations_path, class: "btn btn-secondary" %>
    </div>
  </div>
<% end %>
