<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="<%= plays_path %>">Плеи</a></li>
    <li class="breadcrumb-item active"><%= @play.name %></li>
  </ol>
</nav>

<div class="d-flex align-items-center justify-content-between mb-4">
  <h1 class="h4 mb-0"><%= @play.name %></h1>
  <div class="d-flex gap-2">
    <%= link_to new_run_path(play_id: @play.id), class: "btn btn-success" do %>
      <i class="bi bi-play"></i> Запуск
    <% end %>
    <%= link_to edit_play_path(@play), class: "btn btn-outline-primary" do %>
      <i class="bi bi-pencil"></i> Редактировать
    <% end %>
    <%= link_to play_path(@play), class: "btn btn-outline-danger", data: { turbo_method: :delete, turbo_confirm: "Удалить?" } do %>
      <i class="bi bi-trash"></i> Удалить
    <% end %>
  </div>
</div>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white">Информация</div>
  <table class="table mb-0">
    <tr><th class="w-25">Название</th><td><%= @play.name %></td></tr>
    <tr><th>ОС</th><td><span class="badge bg-secondary"><%= @play.os_type %></span></td></tr>
    <tr><th>Статус</th><td><%= @play.enabled ? tag.i("", class: "bi bi-check-circle-fill text-success") : tag.i("", class: "bi bi-x-circle text-muted") %></td></tr>
    <tr><th>Описание</th><td class="text-muted"><%= @play.description %></td></tr>
  </table>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white">Содержимое</div>
  <pre class="mb-0 p-3 bg-light" style="max-height: 500px; overflow: auto;"><code><%= @play.content %></code></pre>
</div>
