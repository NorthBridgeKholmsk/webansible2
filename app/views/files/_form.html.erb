<%= form_with model: @file, url: (@file.persisted? ? file_path(@file) : files_path), method: (@file.persisted? ? :patch : :post), class: "row g-3" do |f| %>
  <div class="col-md-6">
    <%= f.label :name, "Имя файла", class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>
  <div class="col-md-6">
    <%= f.label :path, "Путь в проекте", class: "form-label" %>
    <%= f.text_field :path, class: "form-control" %>
  </div>
  <div class="col-md-6">
    <%= f.label :organization_id, "Организация", class: "form-label" %>
    <%= f.select :organization_id, options_from_collection_for_select(@organizations, :id, :name, @file.organization_id), { include_blank: "—" }, class: "form-select" %>
  </div>
  <div class="col-md-6">
    <%= f.label :mime_type, "Тип файла", class: "form-label" %>
    <%= f.text_field :mime_type, class: "form-control", value: (@file.mime_type.presence || "text/plain") %>
  </div>
  <div class="col-12">
    <%= f.label :content, "Содержимое", class: "form-label" %>
    <%= f.text_area :content, rows: 16, class: "form-control font-monospace", placeholder: "# YAML content..." %>
  </div>
  <div class="col-12">
    <div class="d-flex gap-2">
      <%= f.submit "Сохранить", class: "btn btn-primary" %>
      <%= link_to "Отмена", files_path, class: "btn btn-secondary" %>
    </div>
  </div>
<% end %>
