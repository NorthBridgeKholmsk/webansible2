<div class="d-flex align-items-center justify-content-between mb-4">
  <h1 class="h4 mb-0">Файлы проекта</h1>
  <%= link_to "Новый файл", new_file_path, class: "btn btn-primary" %>
</div>

<div class="card border-0 shadow-sm">
  <table class="table table-hover mb-0">
    <thead>
      <tr>
        <th>Имя</th>
        <th>Путь</th>
        <th>Организация</th>
        <th>Размер</th>
        <th class="text-end">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% @files.each do |file| %>
        <tr>
          <td><code><%= file.name %></code></td>
          <td class="text-muted"><%= file.path %></td>
          <td class="text-muted"><%= file.organization&.name %></td>
          <td><%= file.content.to_s.bytesize %> B</td>
          <td class="text-end">
            <%= link_to file_path(file), class: "btn btn-sm btn-outline-secondary" do %>
              <i class="bi bi-eye"></i>
            <% end %>
            <%= link_to edit_file_path(file), class: "btn btn-sm btn-outline-primary" do %>
              <i class="bi bi-pencil"></i>
            <% end %>
            <%= link_to file_path(file), class: "btn btn-sm btn-outline-danger", data: { turbo_method: :delete, turbo_confirm: "Удалить?" } do %>
              <i class="bi bi-trash"></i>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @files.empty? %>
    <div class="card-body text-center text-muted">Файлы отсутствуют</div>
  <% end %>
</div>
