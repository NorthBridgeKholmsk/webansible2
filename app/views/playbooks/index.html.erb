<div class="d-flex align-items-center justify-content-between mb-4">
  <h1 class="h4 mb-0">Плейбуки</h1>
  <%= link_to "Новый плейбук", new_playbook_path, class: "btn btn-primary" %>
</div>

<div class="card border-0 shadow-sm">
  <table class="table table-hover mb-0">
    <thead>
      <tr>
        <th>Название</th>
        <th>ОС (ветвления с плеями)</th>
        <th class="text-end">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% @playbooks.each do |pb| %>
        <tr>
          <td><%= link_to pb.name, playbook_path(pb), class: "text-decoration-none" %></td>
          <td>
            <% if (os_list = pb.os_types_with_plays).empty? %>
              <span class="text-muted">—</span>
            <% else %>
              <% os_list.each do |os| %>
                <span class="badge bg-secondary me-1"><%= os %></span>
              <% end %>
            <% end %>
          </td>
          <td class="text-end">
            <%= link_to edit_playbook_path(pb), class: "btn btn-sm btn-outline-primary" do %>
              <i class="bi bi-pencil"></i>
            <% end %>
            <%= link_to playbook_path(pb), class: "btn btn-sm btn-outline-danger", data: { turbo_method: :delete, turbo_confirm: "Удалить?" } do %>
              <i class="bi bi-trash"></i>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @playbooks.empty? %>
    <div class="card-body text-center text-muted">Плейбуки отсутствуют</div>
  <% end %>
</div>