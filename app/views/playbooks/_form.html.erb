<% if @playbook.errors.any? %>
  <div class="col-12">
    <div class="alert alert-danger" role="alert">
      <strong>Плейбук не сохранён</strong>. Исправьте выделенные поля:
      <ul class="mb-0 mt-2">
        <% @playbook.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
<%= form_with model: @playbook, url: (@playbook.persisted? ? playbook_path(@playbook) : playbooks_path), method: (@playbook.persisted? ? :patch : :post), class: "row g-3" do |f| %>
  <div class="col-md-6">
    <%= f.label :name, "Название", class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>
  <div class="col-12">
    <%= f.label :description, "Описание", class: "form-label" %>
    <%= f.text_area :description, rows: 2, class: "form-control" %>
  </div>

  <div class="col-12">
    <span class="form-label d-block fw-bold mb-1">Ветвления по ОС</span>
    <p class="text-muted small mb-3">Добавьте ветвление для типа ОС и заполните его плеями — внутри ветвления плеи выполняются в порядке списка.</p>

    <div id="playbook-sections">
      <% @playbook.sections.each do |section| %>
        <% prefix = section.persisted? ? "playbook[sections_attributes][#{section.id}]" : "playbook[sections_attributes][]" %>
        <%= render "playbook_section_block", section: section, name_prefix: prefix %>
      <% end %>
    </div>

    <button type="button" id="add-os-section-btn" class="btn btn-outline-primary btn-sm mt-2">
      <i class="bi bi-plus-lg"></i> Добавить ветвление по ОС
    </button>
  </div>

  <div class="col-12">
    <div class="d-flex gap-2">
      <%= f.submit "Сохранить", class: "btn btn-primary" %>
      <%= link_to "Отмена", playbooks_path, class: "btn btn-secondary" %>
    </div>
  </div>
<% end %>

<!-- Шаблон пустого ветвления: JS клонирует его по кнопке «Добавить ветвление по ОС». -->
<template id="playbook-section-template">
  <%= render "playbook_section_block", section: PlaybookSection.new, name_prefix: "playbook[sections_attributes][]" %>
</template>