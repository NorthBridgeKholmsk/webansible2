  <% if @playbook.errors.any? %>
    <div class="col-12">
      <div class="alert alert-danger" role="alert">
        <strong>Пейбук не сохранён</strong>. Исправьте выделенные поля:
        <ul class="mb-0 mt-2">
          <% @playbook.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>
<%= form_with model: @playbook, url: (@playbook.persisted? ? playbook_path(@playbook) : playbooks_path), method: (@playbook.persisted? ? :patch : :post), class: "row g-3" do |f| %>
  <div class="col-md-6">
    <%= f.label :name, "Название", class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>
  <div class="col-12">
    <%= f.label :os_type, "Операционная система", class: "form-label" %>
    <%= f.select :os_type, host_option_select_options("os_type"), { include_blank: "—" }, class: "form-select", required: true %>
  </div>
  <div class="col-12">
    <%= f.label :description, "Описание", class: "form-label" %>
    <%= f.text_area :description, rows: 2, class: "form-control" %>
  </div>
  <div class="col-12">
    <%= f.label :content, "Содержимое", class: "form-label" %>
    <%= f.text_area :content, rows: 16, class: "form-control font-monospace", placeholder: "---\n- host: all\n  tasks:" %>
  </div>
  <div class="col-12">
    <div class="form-check form-switch">
      <%= f.check_box :enabled, class: "form-check-input", checked: @playbook.enabled.nil? ? true : @playbook.enabled %>
      <%= f.label :enabled, "Активен", class: "form-check-label" %>
    </div>
  </div>
  <div class="col-12">
    <div class="d-flex gap-2">
      <%= f.submit "Сохранить", class: "btn btn-primary" %>
      <%= link_to "Отмена", playbooks_path, class: "btn btn-secondary" %>
    </div>
  </div>
<% end %>
