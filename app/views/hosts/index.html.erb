<div class="d-flex align-items-center justify-content-between mb-4">
  <h1 class="h4 mb-0">Хосты</h1>
  <%= link_to "Новый хост", new_host_path, class: "btn btn-primary" %>
</div>

<%= form_with url: hosts_path, method: :get, local: true do %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body row g-3 align-items-end">
      <div class="col-md-3">
        <%= label_tag :q, "Название / IP", class: "form-label" %>
        <%= text_field_tag :q, params[:q], placeholder: "Частичное совпадение", class: "form-control" %>
      </div>
      <div class="col-md-2">
        <%= label_tag :type, "Тип хоста", class: "form-label" %>
        <%= select_tag :type, options_for_select(host_option_select_options("type"), params[:type]), include_blank: "—", class: "form-select" %>
      </div>
      <div class="col-md-2">
        <%= label_tag :role, "Роль", class: "form-label" %>
        <%= select_tag :role, options_for_select(host_option_select_options("role"), params[:role]), include_blank: "—", class: "form-select" %>
      </div>
      <div class="col-md-2">
        <%= label_tag :os_type, "Тип ОС", class: "form-label" %>
        <%= select_tag :os_type, options_for_select(host_option_select_options("os_type"), params[:os_type]), include_blank: "—", class: "form-select" %>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <%= submit_tag "Найти", class: "btn btn-primary" %>
        <%= link_to "Сбросить", hosts_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
<% end %>

<div class="card border-0 shadow-sm">
  <table class="table table-hover mb-0">
    <thead>
      <tr>
        <th>Название</th>
        <th>IP</th>
        <th>Роль</th>
        <th>Организация</th>
        <th>Источник</th>
        <th>Создан</th>
        <th class="text-end">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% @hosts.each do |host| %>
        <tr>
          <td><%= link_to host.name, host_path(host), class: "text-decoration-none" %></td>
          <td><code><%= host.ip %></code></td>
          <td><span class="badge bg-primary"><%= host.role %></span></td>
          <td class="text-muted"><%= host.organization&.name %></td>
          <td><span class="badge <%= host.source == Host::SOURCE_ZABBIX ? "bg-info text-dark" : "bg-secondary" %>"><%= host.source_label %></span></td>
          <td class="text-muted small"><%= host.created_at.strftime("%d.%m.%Y") %></td>
          <td class="text-end">
            <%= link_to host_path(host), class: "btn btn-sm btn-outline-secondary" do %>
              <i class="bi bi-eye"></i>
            <% end %>
            <%= link_to new_run_path(host_id: host.id), class: "btn btn-sm btn-outline-success", title: "Запуск" do %>
              <i class="bi bi-play"></i>
            <% end %>
            <%= link_to edit_host_path(host), class: "btn btn-sm btn-outline-primary" do %>
              <i class="bi bi-pencil"></i>
            <% end %>
            <%= link_to host_path(host), class: "btn btn-sm btn-outline-danger", data: { turbo_method: :delete, turbo_confirm: "Удалить?" } do %>
              <i class="bi bi-trash"></i>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @hosts.empty? %>
    <div class="card-body text-center text-muted">Хосты отсутствуют</div>
  <% end %>
</div>
