  <% if @host.errors.any? %>
    <div class="col-12">
      <div class="alert alert-danger" role="alert">
        <strong>Хост не сохранён</strong>. Исправьте выделенные поля:
        <ul class="mb-0 mt-2">
          <% @host.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>
<%= form_with model: @host, url: (@host.persisted? ? host_path(@host) : hosts_path), method: (@host.persisted? ? :patch : :post), class: "row g-3" do |f| %>
  <div class="col-md-6">
    <%= f.label :name, "Название", class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>
  <div class="col-md-6">
    <%= f.label :ip, "IP-адрес", class: "form-label" %>
    <%= f.text_field :ip, class: "form-control", required: true %>
  </div>
  <div class="col-md-6">
    <%= f.label :login, "Логин", class: "form-label" %>
    <%= f.text_field :login, class: "form-control" %>
  </div>
  <div class="col-md-6">
    <%= f.label :password, "Пароль", class: "form-label" %>
    <%= f.password_field :password, class: "form-control" %>
  </div>
  <div class="col-md-4">
    <%= f.label :type, "Тип хоста", class: "form-label" %>
    <%= f.select :type, host_option_select_options("type"), { include_blank: "—" }, class: "form-select", required: true %>
  </div>
  <div class="col-md-6">
    <%= f.label :role, "Роль хоста", class: "form-label" %>
    <%= f.select :role,
          host_option_select_options("role"),
          { selected: (@host.persisted? ? @host.role_array : []) },
          { multiple: true, size: 6, class: "form-select" } %>
  </div>
  <div class="col-md-4">
    <%= f.label :os_type, "Тип ОС", class: "form-label" %>
    <%= f.select :os_type, host_option_select_options("os_type"), { include_blank: "—" }, class: "form-select", required: true %>
  </div>
  <div class="col-md-4">
    <%= f.label :organization_id, "Организация", class: "form-label" %>
    <%= f.select :organization_id, options_from_collection_for_select(@organizations, :id, :name, @host.organization_id), { include_blank: "—" }, class: "form-select" %>
  </div>
  <div class="col-md-4">
    <%= f.label :source, "Источник", class: "form-label" %>
    <%# Нередактируемое поле: фиксируется при создании (UI — «Вручную», синк Zabbix — «Zabbix»). %>
    <input type="text" class="form-control" value="<%= @host.persisted? ? @host.source_label : "Вручную" %>" disabled>
  </div>
  <div class="col-12">
    <label class="form-label">Переменные хоста</label>
    <div id="variables-container" data-variable-prefix="host">
      <% @host.variables.each_with_index do |v, i| %>
        <%= render "variables/form_field", f: f, variable: v, index: i, prefix: "host" %>
      <% end %>
    </div>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="add-variable">Добавить переменную</button>
  </div>
  <div class="col-12">
    <div class="d-flex gap-2">
      <%= f.submit "Сохранить", class: "btn btn-primary" %>
      <%= link_to "Отмена", hosts_path, class: "btn btn-secondary" %>
    </div>
  </div>
<% end %>
